[Unit]
Description=Ubuntu Mic & Audio Fixer Background Service
Documentation=https://github.com/ubuntu/ubuntu-mic-fixer
After=pipewire.service wireplumber.service sound.target
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/ubuntu-mic-fixer --daemon
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
